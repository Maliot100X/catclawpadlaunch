# CatClawPad local env — NEVER commit real secrets
# Cluster switch: devnet | testnet | mainnet-beta

NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Prefer Helius when you have it:
# SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Optional: real upstream LLM (else gateway returns local mock)
# UPSTREAM_OPENAI_BASE_URL=https://llmpad.tech/api/public/v1
# UPSTREAM_OPENAI_API_KEY=

# Launch: keep mock on until real pump txs ready
LAUNCH_MOCK=1
SOL_USD_STUB=200

# Later (Neon / authority) — fill when ready, never chat-paste
# DATABASE_URL=
# POOL_FEE_WALLET=
# AUTHORITY_SECRET_B58=
